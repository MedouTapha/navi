# ════════════════════════════════════════════════════════════════
#  Configuration d'environnement — Navi Education (PRODUCTION)
#  Copier vers : /etc/navi-education/navi.env
#  Puis : sudo chmod 600 /etc/navi-education/navi.env
#  ⚠️  Ce fichier contient des secrets — ne jamais le committer dans git.
# ════════════════════════════════════════════════════════════════

# Profil Spring (toujours prod sur le serveur)
SPRING_PROFILES_ACTIVE=prod

# ── Base de données PostgreSQL ──
DATABASE_URL=jdbc:postgresql://localhost:5432/navi_education
DB_USERNAME=navi_user
DB_PASSWORD=CHANGEZ_MOI_mot_de_passe_base_de_donnees

# ── Compte administrateur initial (créé au premier démarrage) ──
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGEZ_MOI_mot_de_passe_admin_tres_fort

# ── Données de démonstration (false en production) ──
SEED_DEMO_DATA=false

# ── Port interne (l'app reste derrière Nginx) ──
SERVER_PORT=8080
